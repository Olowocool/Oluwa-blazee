+def filter_history_before_date(history_df, game_date):
+    """Return only completed games strictly before the target game date.
+
+    The target date is treated as a calendar date. Excluding the entire target
+    date avoids using the target game's result or another same-day result when
+    timestamps are not available. If a target date is supplied but the history
+    has no usable date column, fail closed rather than silently use future data.
+    """
+    if history_df is None:
+        return pd.DataFrame()
+
+    filtered = history_df.copy()
+    if filtered.empty:
+        return filtered
+
+    if "game_date" not in filtered.columns:
+        if game_date is not None:
+            raise ValueError("Historical data must contain game_date when game_date is supplied")
+        return filtered
+
+    dates = pd.to_datetime(filtered["game_date"], errors="coerce")
+    if getattr(dates.dt, "tz", None) is not None:
+        dates = dates.dt.tz_localize(None)
+    valid_dates = dates.notna()
+    filtered = filtered.loc[valid_dates].copy()
+    filtered["game_date"] = dates.loc[valid_dates]
+
+    if game_date is None:
+        return filtered.sort_values("game_date").reset_index(drop=True)
+
+    target = pd.to_datetime(game_date, errors="coerce")
+    if pd.isna(target):
+        raise ValueError(f"Invalid target game_date: {game_date!r}")
+    if getattr(target, "tzinfo", None) is not None:
+        target = target.tz_localize(None)
+    target = target.normalize()
+
+    dates = pd.to_datetime(filtered["game_date"], errors="coerce")
+    mask = dates < target
+    filtered = filtered.loc[mask].copy()
+    filtered["game_date"] = dates.loc[mask]
+    return filtered.sort_values("game_date").reset_index(drop=True)
 
 
